# Browser-safe values only. See ARCHITECTURE.md for the complete contract.
NEXT_PUBLIC_APP_NAME=Malik
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional public map configuration. Mapbox is used by default, then Google Maps.
NEXT_PUBLIC_MAP_PROVIDER=mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Do not put credentials, session secrets, database URLs, or payment keys here.
