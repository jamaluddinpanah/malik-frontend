# Browser-safe values only. See ARCHITECTURE.md for the complete contract.
NEXT_PUBLIC_APP_NAME=Malik
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_REVERB_APP_KEY=malik-reverb-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
# Optional public map configuration. Google Maps is used when its key is set;
# Mapbox is the fallback if Google is unavailable.
NEXT_PUBLIC_MAP_PROVIDER=google
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Do not put credentials, session secrets, database URLs, or payment keys here.
